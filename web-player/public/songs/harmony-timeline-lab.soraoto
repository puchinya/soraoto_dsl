project {
  version: 1
  title: "Harmony Timeline Lab"
  tempo: 118bpm
  meter: 4/4
  key: C.major

  chords Harmony {
    @1:
    Imaj7,
    V/vi,
    vi,
    IVmaj7,
    C/E,
    G/B,
    ii7,
    V7,
  }

  track Bass {
    instrument: bass
    follow Harmony {
      @4:
      bass . fifth .,
    }
  }

  track Piano {
    instrument: piano
    Harmony |> PianoVoicing(range: c3..c5, voice_leading: nearest)
  }

  track Guitar {
    instrument: guitar
    Harmony
    |> GuitarVoicing(style: open, voice_leading: nearest)
    |> GuitarStrum(style: pop8)
  }

  track Arp {
    instrument: synth
    Harmony |> Arpeggio(pattern: [1, 3, 5, 7], duration: @8, range: c5..c6)
  }

  track Drums {
    instrument: drums
    drums {
      @16:
      Kick  "x...x...x...x...x...x...x...x..."
      Snare "....X.......X.......X.......X..."
      Hat   "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
  }
}
