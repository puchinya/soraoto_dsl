import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "After Rain, 5 PM"
  tempo: 96bpm
  meter: 4/4
  key: E.major

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Emaj7,
      B/D#,
      C#m7,
      Amaj7,
    }
    A {
      Emaj7,
      G#m7,
      C#m7,
      Amaj7,
      Emaj7,
      G#m7,
      C#m7,
      Amaj7,
    }
    B {
      F#m7,
      G#m7,
      Amaj7,
      B7,
    }
    Hook {
      Amaj7,
      B,
      G#m7,
      C#m7,
      Amaj7,
      B,
      G#m7,
      C#m7,
    }
    Break {
      F#m7,
      Amaj7,
      E,
      B,
    }
    Final {
      Amaj7,
      B,
      G#m7,
      C#m7,
      Amaj7,
      B,
      G#m7,
      C#m7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: soft_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        a3 ~ ~ ~ ~ _ _ a3 ~ _ b3 ~ ~ _ _ _ ,
        _ _ g#4 ~ ~ _ _ b4 ~ ~ _ _ _ _ _ _ ,
        c#4 ~ ~ _ _ b3 ~ ~ _ _ e4 ~ _ _ _ _ ,
        _ b3 ~ _ c#4 ~ ~ ~ _ _ _ a3 ~ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        e4 ~ ~ ~ ~ _ _ f#4 ~ _ g#4 ~ ~ _ b4 ~ ,
        _ _ f#4 ~ ~ _ _ g#4 ~ ~ _ _ b4 ~ ~ ~ ,
        e4 ~ ~ _ _ e4 ~ ~ _ _ e4 ~ _ e4 ~ ~ ,
        _ e4 ~ _ a3 ~ ~ ~ _ _ _ a3 ~ _ c#4 ~ ,
        b3 ~ ~ ~ ~ _ _ a3 ~ _ a3 ~ ~ _ a3 ~ ,
        _ _ g#4 ~ ~ _ _ f#4 ~ ~ _ _ g#4 ~ ~ ~ ,
        e4 ~ ~ _ _ b4 ~ ~ _ _ a4 ~ _ e4 ~ ~ ,
        _ b4 ~ _ e4 ~ ~ ~ _ _ _ f#4 ~ _ e4 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        a4 ~ ~ ~ ~ _ _ f4 ~ _ g#4 ~ ~ _ e4 ~ ,
        _ _ f#4 ~ ~ _ _ a#4 ~ ~ _ _ f#4 ~ ~ ~ ,
        a4 ~ ~ _ _ e4 ~ ~ _ _ e4 ~ _ a4 ~ ~ ,
        _ e4 ~ _ d#4 ~ ~ ~ _ _ _ g#4 ~ _ f#4 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        a5 ~ ~ ~ ~ _ _ c5 ~ _ f#4 ~ ~ _ e5 ~ ,
        _ _ g#5 ~ ~ _ _ a#4 ~ ~ _ _ f#5 ~ ~ ~ ,
        b5 ~ ~ _ _ b5 ~ ~ _ _ a5 ~ _ b4 ~ ~ ,
        _ b5 ~ _ c#5 ~ ~ ~ _ _ _ a#4 ~ _ c#5 ~ ,
        e5 ~ ~ ~ ~ _ _ c5 ~ _ g#4 ~ ~ _ a4 ~ ,
        _ _ f#5 ~ ~ _ _ d5 ~ ~ _ _ b4 ~ ~ ~ ,
        d#6 ~ ~ _ _ e6 ~ ~ _ _ e6 ~ _ d#6 ~ ~ ,
        _ e5 ~ _ g#4 ~ ~ ~ _ _ _ c5 ~ _ b4 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        a3 ~ ~ ~ ~ _ _ a3 ~ _ c#4 ~ ~ _ _ _ ,
        _ _ g#4 ~ ~ _ _ c#4 ~ ~ _ _ _ _ _ _ ,
        e4 ~ ~ _ _ b4 ~ ~ _ _ e4 ~ _ _ _ _ ,
        _ b3 ~ _ d#4 ~ ~ ~ _ _ _ b3 ~ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        e6 ~ ~ ~ ~ _ _ c6 ~ _ g#5 ~ ~ _ e5 a4 ,
        _ _ f#5 ~ ~ _ _ f5 ~ ~ _ _ b4 ~ ~ b4 ,
        f#6 ~ ~ _ _ e6 ~ ~ _ _ e6 ~ _ g#5 ~ d#5 ,
        _ e5 ~ _ b4 ~ ~ ~ _ _ _ d#5 ~ _ f#4 e5 ,
        a5 ~ ~ ~ ~ _ _ d#5 ~ _ f#5 ~ ~ _ b5 e5 ,
        _ _ g#5 ~ ~ _ _ d5 ~ ~ _ _ f#5 ~ ~ f#5 ,
        d#6 ~ ~ _ _ b5 ~ ~ _ _ a5 ~ _ f#5 ~ f#5 ,
        _ b5 ~ _ e5 ~ ~ ~ _ _ _ c5 ~ _ g#4 b4 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: digital_bell
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d#6 ~ _ _ _ _ _ _ f#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d#6 ~ _ _ _ _ _ _ f#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ a5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ d#6 ~ _ _ _ _ _ f#6 ~ _ _ g#5 ~ ,
        _ _ _ g#5 ~ _ _ _ _ _ a5 ~ _ _ c#6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d#6 ~ _ _ f#6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d#6 ~ _ _ f#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ d#6 ~ _ _ _ _ _ f#6 ~ _ _ b5 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ e6 ~ _ _ _ _ _ _ g#5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d#6 ~ _ _ _ _ _ _ f#6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d#6 ~ _ _ f#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ d#6 ~ _ _ _ _ _ f#6 ~ _ _ b5 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument: bass
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
  
    effects {
      ChannelStrip {
        preset: bass
      }
    }
}

  track Piano {
    instrument: piano
    gain: -13db
    pan: -0.10
    Harmony |> PianoVoicing(range: c3..c5, voice_leading: nearest, voices: 4)
  
    effects {
      ChannelStrip {
        preset: keys
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: warm_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_pop
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2052
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_pop
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "..............................x...............................x."
      Tom "............................................................x.xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
      Tom "............................................................x.xx"
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }

    humanize {
      timing: 3ms
      velocity: 0.04
      seed: 1052
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: plate
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Bass -> Master
    Piano -> Master
    Atmosphere -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Piano -> Space { gain: -19db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Drums -> Space { gain: -24db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -11.8db
    A: -11.0db
    B: -10.3db
    Hook: -9.5db
    Break: -12.2db
    Final: -9.1db
  }

  automation Counter.gain {
    Intro: -20.2db
    A: -19.4db
    B: -17.5db
    Hook: -16.7db
    Break: -20.6db
    Final: -16.3db
  }

  automation Bass.gain {
    Intro: -11.7db
    A: -10.9db
    B: -10.2db
    Hook: -9.4db
    Break: -12.7db
    Final: -9.0db
  }

  automation Piano.gain {
    Intro: -14.9db
    A: -14.1db
    B: -13.4db
    Hook: -12.6db
    Break: -15.3db
    Final: -12.2db
  }

  automation Atmosphere.gain {
    Intro: -21.6db
    A: -20.8db
    B: -20.1db
    Hook: -19.3db
    Break: -21.2db
    Final: -18.9db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    B: 1.04
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    B: -19db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    B: 0.8
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
      }
      Limiter {
        ceiling: -1db
      }
    }
    gain: -1db
  }
}
