  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: hall
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Bass -> Master
    Arp -> Master
    Atmosphere -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Arp -> Space { gain: -19db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Drums -> Space { gain: -24db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -11.6db
    A: -10.8db
    B: -10.1db
    Hook: -9.3db
    Break: -12.0db
    Final: -8.9db
  }

  automation Counter.gain {
    Intro: -20.0db
    A: -19.2db
    B: -17.3db
    Hook: -16.5db
    Break: -20.4db
    Final: -16.1db
  }

  automation Bass.gain {
    Intro: -12.0db
    A: -11.2db
    B: -10.5db
    Hook: -9.7db
    Break: -13.0db
    Final: -9.3db
  }

  automation Arp.gain {
    Intro: -18.7db
    A: -17.9db
    B: -17.2db
    Hook: -16.4db
    Break: -19.1db
    Final: -16.0db
  }

  automation Atmosphere.gain {
    Intro: -21.9db
    A: -21.1db
    B: -20.4db
    Hook: -19.6db
    Break: -21.5db
    Final: -19.2db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    B: 1.04
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    B: -19db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    B: 0.8
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
      }
      Limiter {
        ceiling: -1db
