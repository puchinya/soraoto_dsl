import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Break the Core"
  tempo: 150bpm
  meter: 4/4
  key: F#.minor

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      F#m,
      E,
      D,
      C#7,
    }
    A {
      F#m,
      E,
      D,
      C#7,
      F#m,
      E,
      D,
      C#7,
    }
    B {
      Bm7,
      D,
      E,
      C#7,
    }
    Hook {
      D,
      E,
      F#m,
      C#7,
      D,
      E,
      F#m,
      C#7,
    }
    Break {
      Bm7,
      D,
      F#m,
      E,
    }
    Final {
      D,
      E,
      F#m,
      C#7,
      D,
      E,
      F#m,
      C#7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: pulse_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        a3 ~ ~ ~ ~ _ _ a3 ~ _ a3 ~ ~ _ _ _ ,
        _ _ g#4 ~ ~ _ _ g#4 ~ ~ _ _ _ _ _ _ ,
        a4 ~ ~ _ _ a4 ~ ~ _ _ a4 ~ _ _ _ _ ,
        _ a3 ~ _ a3 ~ ~ ~ _ _ _ c#4 ~ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        a4 ~ ~ ~ ~ _ _ b4 ~ _ e5 ~ ~ _ c#5 ~ ,
        _ _ b4 ~ ~ _ _ e5 ~ ~ _ _ e5 ~ ~ ~ ,
        d5 ~ ~ _ _ g#4 ~ ~ _ _ f#4 ~ _ f#4 ~ ~ ,
        _ g#4 ~ _ c#4 ~ ~ ~ _ _ _ a3 ~ _ a3 ~ ,
        c#4 ~ ~ ~ ~ _ _ g#4 ~ _ c#5 ~ ~ _ f#4 ~ ,
        _ _ g#4 ~ ~ _ _ c#5 ~ ~ _ _ e5 ~ ~ ~ ,
        a4 ~ ~ _ _ a4 ~ ~ _ _ d5 ~ _ a4 ~ ~ ,
        _ a4 ~ _ b4 ~ ~ ~ _ _ _ b4 ~ _ c#5 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        d5 ~ ~ ~ ~ _ _ a#4 ~ _ e5 ~ ~ _ f#5 ~ ,
        _ _ b4 ~ ~ _ _ f5 ~ ~ _ _ a5 ~ ~ ~ ,
        g#5 ~ ~ _ _ g#5 ~ ~ _ _ f#5 ~ _ g#5 ~ ~ ,
        _ g#4 ~ _ f4 ~ ~ ~ _ _ _ g4 ~ _ c#5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        a5 ~ ~ ~ ~ _ _ c#5 ~ _ c#5 ~ ~ _ d5 ~ ,
        _ _ g#5 ~ ~ _ _ g5 ~ ~ _ _ e5 ~ ~ ~ ,
        a5 ~ ~ _ _ a5 ~ ~ _ _ d6 ~ _ f#5 ~ ~ ,
        _ a5 ~ _ g#5 ~ ~ ~ _ _ _ e5 ~ _ g#5 ~ ,
        a5 ~ ~ ~ ~ _ _ f5 ~ _ e5 ~ ~ _ d5 ~ ,
        _ _ b5 ~ ~ _ _ a#5 ~ ~ _ _ b5 ~ ~ ~ ,
        c#6 ~ ~ _ _ g#5 ~ ~ _ _ f#5 ~ _ c#5 ~ ~ ,
        _ g#5 ~ _ g#5 ~ ~ ~ _ _ _ c5 ~ _ f5 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        b3 ~ ~ ~ ~ _ _ a3 ~ _ a3 ~ ~ _ _ _ ,
        _ _ g#4 ~ ~ _ _ a4 ~ ~ _ _ _ _ _ _ ,
        a4 ~ ~ _ _ a4 ~ ~ _ _ a4 ~ _ _ _ _ ,
        _ a3 ~ _ a3 ~ ~ ~ _ _ _ e4 ~ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        a5 ~ ~ ~ ~ _ _ f5 ~ _ e5 ~ ~ _ g#4 d5 ,
        _ _ b5 ~ ~ _ _ d#6 ~ ~ _ _ e6 ~ ~ b5 ,
        c#6 ~ ~ _ _ g#5 ~ ~ _ _ f#5 ~ _ g#5 ~ a5 ,
        _ g#5 ~ _ b4 ~ ~ ~ _ _ _ c5 ~ _ c#5 c#5 ,
        d6 ~ ~ ~ ~ _ _ c#6 ~ _ c#6 ~ ~ _ a5 a5 ,
        _ _ g#5 ~ ~ _ _ a#5 ~ ~ _ _ e5 ~ ~ b5 ,
        a5 ~ ~ _ _ a5 ~ ~ _ _ d6 ~ _ b5 ~ c#6 ,
        _ a5 ~ _ g#5 ~ ~ ~ _ _ _ e5 ~ _ e5 c#5 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: bright_pluck
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c#6 ~ _ _ _ _ _ _ f6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ e6 ~ _ _ _ _ _ _ g#5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c#6 ~ _ _ _ _ _ _ f6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g#5 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c#6 ~ _ _ _ _ _ _ f6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a5 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#5 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f6 ~ _ _ g#5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ a6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c#6 ~ _ _ f#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f6 ~ _ _ g#6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ g#6 ~ _ _ _ _ _ b5 ~ _ _ e6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f6 ~ _ _ g#6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g#5 ~ _ _ _ _ _ _ b5 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ a6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c#6 ~ _ _ f#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f6 ~ _ _ g#6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ g#6 ~ _ _ _ _ _ b5 ~ _ _ e6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ f6 ~ _ _ g#6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: reese_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Arp {
    instrument {
      SuperSynth {
        preset: filter_motion
        filter_cutoff: 6.0khz
      }
    }
    gain: -17db
    Harmony |> Arpeggio(pattern: [1, 5, 3, 7], duration: @16, range: c4..c7)
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: dark_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_edm
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x."
    }
    A {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xxx.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xx"
    }
    B {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xxx..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }
    Break {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x."
    }
    Final {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xxx..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2094
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_edm
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
