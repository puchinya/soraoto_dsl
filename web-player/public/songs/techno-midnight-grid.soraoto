  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: ambience
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Bass -> Master
    Arp -> Master
    Atmosphere -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Arp -> Space { gain: -19db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Drums -> Space { gain: -24db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -12.0db
    A: -11.2db
    Hook: -9.7db
    Break: -12.4db
    Final: -9.3db
  }

  automation Counter.gain {
    Intro: -19.9db
    A: -19.1db
    Hook: -16.4db
    Break: -20.3db
    Final: -16.0db
  }

  automation Bass.gain {
    Intro: -11.9db
    A: -11.1db
    Hook: -9.6db
    Break: -12.9db
    Final: -9.2db
  }

  automation Arp.gain {
    Intro: -18.6db
    A: -17.8db
    Hook: -16.3db
    Break: -19.0db
    Final: -15.9db
  }

  automation Atmosphere.gain {
    Intro: -21.8db
    A: -21.0db
    Hook: -19.5db
    Break: -21.4db
    Final: -19.1db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
      }
      Limiter {
        ceiling: -1db
