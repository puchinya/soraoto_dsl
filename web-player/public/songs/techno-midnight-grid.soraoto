        f5 ~ _ g5 ~ _ g5 ~ ~ ~ _ _ g#5 ~ _ c6 ,
        g5 ~ ~ ~ _ _ g5 ~ _ c5 ~ ~ _ _ g5 ~ ,
        c6 ~ ~ _ f5 ~ _ g5 ~ ~ _ _ c#5 ~ ~ _ ,
        _ c6 ~ _ a#5 ~ ~ _ d#5 ~ _ a4 ~ _ g5 ~ ,
        c6 ~ _ e5 ~ _ f5 ~ ~ ~ _ _ g#5 ~ _ f5 ,
