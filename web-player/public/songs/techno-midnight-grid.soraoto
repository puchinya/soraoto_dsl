        c6 ~ ~ _ g#5 ~ _ e5 ~ ~ _ _ g#5 ~ ~ c#5 ,
        _ c6 ~ _ d#5 ~ ~ _ a#5 ~ _ d5 ~ _ c6 a#5 ,
        f6 ~ _ b5 ~ _ g5 ~ ~ ~ _ _ g#5 ~ _ c6 ,
        g5 ~ ~ ~ _ _ g5 ~ _ c5 ~ ~ _ _ d#5 d#5 ,
        c#6 ~ ~ _ g#5 ~ _ b5 ~ ~ _ _ c#5 ~ ~ c5 ,
