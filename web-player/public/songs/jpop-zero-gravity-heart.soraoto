        _ _ g#5 ~ _ b5 ~ _ b5 ~ ~ ~ _ _ g#5 ~ ,
        f#6 ~ ~ _ _ d6 ~ _ _ c#6 ~ _ f#5 ~ ~ ~ ,
        _ d6 ~ _ e5 ~ _ d#5 ~ ~ _ _ b5 ~ ~ _ ,
        f#5 ~ _ c#5 ~ ~ _ _ a5 ~ ~ _ _ f#5 ~ _ ,
        _ _ a5 ~ _ e6 ~ _ g#5 ~ ~ ~ _ _ b4 ~ ,
