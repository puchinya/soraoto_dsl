        _ _ _ e6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ g#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ g#6 ~ _ _ _ _ _ b5 ~ _ _ e6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
