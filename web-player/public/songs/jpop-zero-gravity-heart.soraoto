  automation Atmosphere.gain {
    Intro: -22.0db
    A: -21.2db
    B: -20.5db
    Hook: -19.7db
    Break: -21.6db
    Final: -19.3db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
