import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Skybound Promise"
  tempo: 166bpm
  meter: 4/4
  key: G.major

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      G,
      D/F#,
      Em7,
      Cmaj7,
    }
    A {
      G,
      D/F#,
      Em7,
      Cmaj7,
      G,
      D/F#,
      Em7,
      Cmaj7,
    }
    B {
      Am7,
      Bm7,
      Cmaj7,
      D,
    }
    Hook {
      Cmaj7,
      D,
      Bm7,
      Em7,
      Cmaj7,
      D,
      Bm7,
      Em7,
    }
    Break {
      Am7,
      Cmaj7,
      G,
      D,
    }
    Final {
      Cmaj7,
      D,
      Bm7,
      Em7,
      Cmaj7,
      D,
      Bm7,
      Em7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: supersaw_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        b3 ~ ~ _ d4 ~ _ b3 ~ ~ _ _ _ _ _ _ ,
        _ b4 ~ _ a4 ~ ~ _ a4 ~ _ f#4 ~ _ _ _ ,
        b4 ~ _ d5 ~ _ c5 ~ ~ ~ _ _ d5 ~ _ _ ,
        g4 ~ ~ ~ _ _ c4 ~ _ b3 ~ ~ _ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        g4 ~ ~ _ d5 ~ _ e5 ~ ~ _ _ g5 ~ ~ _ ,
        _ f#4 ~ _ d4 ~ ~ _ a4 ~ _ g4 ~ _ a4 ~ ,
        e5 ~ _ b4 ~ _ g4 ~ ~ ~ _ _ g4 ~ _ e4 ,
        g4 ~ ~ ~ _ _ g4 ~ _ b4 ~ ~ _ _ c5 ~ ,
        d4 ~ ~ _ g4 ~ _ e4 ~ ~ _ _ b4 ~ ~ _ ,
        _ b4 ~ _ d5 ~ ~ _ d5 ~ _ c5 ~ _ d5 ~ ,
        e5 ~ _ d5 ~ _ c5 ~ ~ ~ _ _ e5 ~ _ e5 ,
        b4 ~ ~ ~ _ _ c5 ~ _ f#5 ~ ~ _ _ c5 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        c5 ~ ~ _ g5 ~ _ f#5 ~ ~ _ _ c5 ~ ~ _ ,
        _ f#5 ~ _ f#5 ~ ~ _ b4 ~ _ g#4 ~ _ b4 ~ ,
        g5 ~ _ b5 ~ _ g5 ~ ~ ~ _ _ c5 ~ _ g5 ,
        a4 ~ ~ ~ _ _ g4 ~ _ b4 ~ ~ _ _ d5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        c6 ~ ~ _ e5 ~ _ a#5 ~ ~ _ _ g5 ~ ~ _ ,
        _ b5 ~ _ a5 ~ ~ _ a5 ~ _ g#5 ~ _ d6 ~ ,
        b5 ~ _ a#5 ~ _ c6 ~ ~ ~ _ _ d6 ~ _ b5 ,
        g5 ~ ~ ~ _ _ c5 ~ _ f#5 ~ ~ _ _ g5 ~ ,
        g5 ~ ~ _ c6 ~ _ a#5 ~ ~ _ _ e5 ~ ~ _ ,
        _ f#6 ~ _ a5 ~ ~ _ f#5 ~ _ c#5 ~ _ f#5 ~ ,
        b5 ~ _ f5 ~ _ g5 ~ ~ ~ _ _ f#5 ~ _ b5 ,
        e6 ~ ~ ~ _ _ g5 ~ _ b4 ~ ~ _ _ g5 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        c4 ~ ~ _ e4 ~ _ c4 ~ ~ _ _ _ _ _ _ ,
        _ b4 ~ _ c5 ~ ~ _ b4 ~ _ _ _ _ _ _ ,
        d5 ~ _ d5 ~ _ g4 ~ ~ ~ _ _ _ _ _ _ ,
        a4 ~ ~ ~ _ _ c5 ~ _ d5 ~ ~ _ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        g6 ~ ~ _ c6 ~ _ b5 ~ ~ _ _ g5 ~ ~ c5 ,
        _ f#6 ~ _ d6 ~ ~ _ f#5 ~ _ c#5 ~ _ b5 d6 ,
        d6 ~ _ g#5 ~ _ g5 ~ ~ ~ _ _ a5 ~ _ d6 ,
        e6 ~ ~ ~ _ _ g5 ~ _ b4 ~ ~ _ _ e5 g5 ,
        c6 ~ ~ _ g5 ~ _ b5 ~ ~ _ _ b5 ~ ~ g5 ,
        _ b5 ~ _ d6 ~ ~ _ a5 ~ _ g#5 ~ _ f#6 d6 ,
        d6 ~ _ c#6 ~ _ c6 ~ ~ ~ _ _ d6 ~ _ d6 ,
        g5 ~ ~ ~ _ _ c6 ~ _ f#6 ~ ~ _ _ e6 e6 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: bright_pluck
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a6 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ a6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ c6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ b5 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ a6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: round_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Piano {
    instrument: piano
    gain: -13db
    pan: -0.10
    Harmony |> PianoVoicing(range: c3..c5, voice_leading: nearest, voices: 4)
  
    effects {
      ChannelStrip {
        preset: keys
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: synth_strings
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_pop
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    A {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xxx...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    B {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    Hook {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }
    Break {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    Final {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2073
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_pop
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
