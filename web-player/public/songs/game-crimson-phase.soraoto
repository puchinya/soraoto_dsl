import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Crimson Phase"
  tempo: 168bpm
  meter: 4/4
  key: D.minor

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Dm,
      Bbmaj7,
      C,
      A7,
    }
    A {
      Dm,
      Bbmaj7,
      C,
      A7,
      Dm,
      Bbmaj7,
      C,
      A7,
    }
    B {
      Gm7,
      Am7,
      Bbmaj7,
      C,
    }
    Hook {
      Bbmaj7,
      C,
      Dm,
      A7,
      Bbmaj7,
      C,
      Dm,
      A7,
    }
    Break {
      Gm7,
      Bbmaj7,
      Dm,
      A7,
    }
    Final {
      Bbmaj7,
      C,
      Dm,
      A7,
      Bbmaj7,
      C,
      Dm,
      A7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: pop_brass
      }
    }
    gain: -11db
    Intro {
      notes {
        @16:
        !mp:
        a3 ~ ~ ~ _ _ a3 ~ _ _ a3 ~ _ _ _ _ ,
        f4 ~ _ _ a#3 ~ ~ ~ _ _ f4 ~ ~ _ _ _ ,
        _ _ e4 ~ _ a#4 ~ ~ _ c5 ~ _ _ _ _ _ ,
        e4 ~ ~ _ a3 ~ _ _ a3 ~ ~ _ _ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        d4 ~ ~ ~ _ _ c4 ~ _ _ a3 ~ _ d4 ~ ~ ,
        a#4 ~ _ _ a4 ~ ~ ~ _ _ e4 ~ ~ _ _ a#3 ,
        _ _ a4 ~ _ e4 ~ ~ _ d4 ~ _ g4 ~ ~ _ ,
        c#4 ~ ~ _ a3 ~ _ _ a3 ~ ~ _ _ c#4 ~ ~ ,
        a4 ~ ~ ~ _ _ a4 ~ _ _ e4 ~ _ a4 ~ ~ ,
        a4 ~ _ _ d4 ~ ~ ~ _ _ a#3 ~ ~ _ _ f4 ,
        _ _ e4 ~ _ a#4 ~ ~ _ f4 ~ _ c5 ~ ~ _ ,
        a4 ~ ~ _ c#5 ~ _ _ a4 ~ ~ _ _ g4 ~ ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        g4 ~ ~ ~ _ _ c5 ~ _ _ a4 ~ _ f4 ~ ~ ,
        e5 ~ _ _ c5 ~ ~ ~ _ _ e5 ~ ~ _ _ e5 ,
        _ _ a4 ~ _ e4 ~ ~ _ d4 ~ _ d4 ~ ~ _ ,
        e4 ~ ~ _ c4 ~ _ _ c4 ~ ~ _ _ e4 ~ ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        a5 ~ ~ ~ _ _ a5 ~ _ _ e5 ~ _ f5 ~ ~ ,
        e5 ~ _ _ c5 ~ ~ ~ _ _ a#5 ~ ~ _ _ c5 ,
        _ _ e5 ~ _ a#5 ~ ~ _ f5 ~ _ a5 ~ ~ _ ,
        e5 ~ ~ _ a4 ~ _ _ g5 ~ ~ _ _ e5 ~ ~ ,
        a#5 ~ ~ ~ _ _ c6 ~ _ _ a5 ~ _ a#5 ~ ~ ,
        g5 ~ _ _ e5 ~ ~ ~ _ _ e5 ~ ~ _ _ g4 ,
        _ _ a5 ~ _ e5 ~ ~ _ d5 ~ _ f5 ~ ~ _ ,
        a5 ~ ~ _ g5 ~ _ _ e5 ~ ~ _ _ a4 ~ ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        a#3 ~ ~ ~ _ _ a3 ~ _ _ a#3 ~ _ _ _ _ ,
        f4 ~ _ _ a#3 ~ ~ ~ _ _ a3 ~ ~ _ _ _ ,
        _ _ e4 ~ _ a#4 ~ ~ _ d5 ~ _ _ _ _ _ ,
        g4 ~ ~ _ c#4 ~ _ _ a3 ~ ~ _ _ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        d6 ~ ~ ~ _ _ c6 ~ _ _ a5 ~ _ e5 ~ a#4 ,
        c6 ~ _ _ g5 ~ ~ ~ _ _ e5 ~ ~ _ _ c5 ,
        _ _ a5 ~ _ e5 ~ ~ _ d5 ~ _ a5 ~ ~ d5 ,
        a5 ~ ~ _ a5 ~ _ _ e5 ~ ~ _ _ e5 ~ g5 ,
        a#5 ~ ~ ~ _ _ a5 ~ _ _ e5 ~ _ a#5 ~ d5 ,
        g5 ~ _ _ c5 ~ ~ ~ _ _ a#5 ~ ~ _ _ e5 ,
        _ _ e6 ~ _ a#5 ~ ~ _ f5 ~ _ d6 ~ ~ a5 ,
        g5 ~ ~ _ c#5 ~ _ _ a5 ~ ~ _ _ a5 ~ a5 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: octave_lead
      }
    }
