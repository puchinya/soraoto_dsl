  automation Pad.gain {
    Intro: -18.9db
    A: -18.1db
    B: -17.4db
    Hook: -16.6db
    Break: -18.5db
    Final: -16.2db
  }

  automation Atmosphere.gain {
    Intro: -21.6db
    A: -20.8db
    B: -20.1db
    Hook: -19.3db
    Break: -21.2db
    Final: -18.9db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    B: 1.04
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    B: -19db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    B: 0.8
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
