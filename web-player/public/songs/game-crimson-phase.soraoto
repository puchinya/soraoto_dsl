  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: hall
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Bass -> Master
    Pad -> Master
    Atmosphere -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Pad -> Space { gain: -17db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Drums -> Space { gain: -24db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -12.8db
    A: -12.0db
    B: -11.3db
    Hook: -10.5db
    Break: -13.2db
    Final: -10.1db
  }

  automation Counter.gain {
    Intro: -20.2db
    A: -19.4db
    B: -17.5db
    Hook: -16.7db
    Break: -20.6db
    Final: -16.3db
  }

  automation Bass.gain {
    Intro: -11.7db
    A: -10.9db
    B: -10.2db
    Hook: -9.4db
    Break: -12.7db
    Final: -9.0db
