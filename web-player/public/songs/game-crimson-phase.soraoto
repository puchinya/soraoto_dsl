    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ a#5 ~ _ _ _ _ _ d6 ~ _ _ f6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g5 ~ _ _ a5 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ a#5 ~ _ _ d6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g5 ~ _ _ c6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ d6 ~ _ _ _ _ _ f6 ~ _ _ a5 ~ ,
        _ _ _ c6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ f6 ~ _ _ _ _ _ a5 ~ _ _ d6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f6 ~ _ _ a5 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ c6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ d6 ~ _ _ f6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ d6 ~ _ _ _ _ _ f6 ~ _ _ a5 ~ ,
        _ _ _ c6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ f6 ~ _ _ _ _ _ a5 ~ _ _ d6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f6 ~ _ _ a5 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ c6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ d6 ~ _ _ f6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: reese_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Pad {
    instrument {
      SuperSynth {
        preset: string_pad
        filter_cutoff: 3.0khz
      }
    }
    gain: -17db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.5
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: dark_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_rock
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x."
    }
    A {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xxx.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xx"
    }
    B {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xxx..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }
    Break {
      @16:
      Kick "x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x.x.....x."
    }
    Final {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xxx..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2087
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

