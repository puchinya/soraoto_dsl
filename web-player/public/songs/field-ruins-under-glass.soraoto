import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Ruins under Glass"
  tempo: 78bpm
  meter: 4/4
  key: A.minor

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Am7,
      Fmaj7,
      Cmaj7,
      G,
    }
    A {
      Am7,
      Fmaj7,
      Cmaj7,
      G,
      Am7,
      Fmaj7,
      Cmaj7,
      G,
    }
    B {
      Dm7,
      Em7,
      Fmaj7,
      G,
    }
    Hook {
      Fmaj7,
      G,
      Am7,
      Em7,
      Fmaj7,
      G,
      Am7,
      Em7,
    }
    Break {
      Dm7,
      Fmaj7,
      Am7,
      G,
    }
    Final {
      Fmaj7,
      G,
      Am7,
      Em7,
      Fmaj7,
      G,
      Am7,
      Em7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: digital_bell
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        c4 ~ ~ ~ _ _ g4 ~ ~ _ _ _ _ _ _ _ ,
        _ _ d4 ~ ~ _ _ c4 ~ _ _ c4 ~ ~ _ _ ,
        g4 ~ ~ _ _ f4 ~ _ _ b4 ~ ~ ~ _ _ _ ,
        _ f4 ~ ~ _ _ e4 ~ ~ _ _ d4 ~ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        c5 ~ ~ ~ _ _ b4 ~ ~ _ _ e5 ~ ~ ~ _ ,
        _ _ b4 ~ ~ _ _ g4 ~ _ _ d5 ~ ~ _ f5 ,
        g5 ~ ~ _ _ d5 ~ _ _ a4 ~ ~ ~ _ c5 ~ ,
        _ d5 ~ ~ _ _ a4 ~ ~ _ _ d5 ~ _ g4 ~ ,
        e4 ~ ~ ~ _ _ d4 ~ ~ _ _ a4 ~ ~ ~ _ ,
        _ _ d5 ~ ~ _ _ c5 ~ _ _ f5 ~ ~ _ c5 ,
        b4 ~ ~ _ _ f5 ~ _ _ e5 ~ ~ ~ _ g5 ~ ,
        _ f4 ~ ~ _ _ e4 ~ ~ _ _ b3 ~ _ d4 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        f5 ~ ~ ~ _ _ b4 ~ ~ _ _ a4 ~ ~ ~ _ ,
        _ _ b4 ~ ~ _ _ a#4 ~ _ _ d#5 ~ ~ _ g5 ,
        a5 ~ ~ _ _ d5 ~ _ _ a4 ~ ~ ~ _ e5 ~ ,
        _ d5 ~ ~ _ _ a4 ~ ~ _ _ c#5 ~ _ b4 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        c6 ~ ~ ~ _ _ d5 ~ ~ _ _ f5 ~ ~ ~ _ ,
        _ _ d6 ~ ~ _ _ f#5 ~ _ _ c#6 ~ ~ _ b5 ,
        g6 ~ ~ _ _ f6 ~ _ _ e6 ~ ~ ~ _ e6 ~ ,
        _ f6 ~ ~ _ _ e6 ~ ~ _ _ d#6 ~ _ b5 ~ ,
        a5 ~ ~ ~ _ _ b4 ~ ~ _ _ c5 ~ ~ ~ _ ,
        _ _ b5 ~ ~ _ _ c#6 ~ _ _ f#5 ~ ~ _ d5 ,
        e6 ~ ~ _ _ d6 ~ _ _ a5 ~ ~ ~ _ a5 ~ ,
        _ d6 ~ ~ _ _ a5 ~ ~ _ _ f#5 ~ _ e5 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        d4 ~ ~ ~ _ _ a4 ~ ~ _ _ _ _ _ _ _ ,
        _ _ d5 ~ ~ _ _ c5 ~ _ _ c5 ~ ~ _ _ ,
        a4 ~ ~ _ _ f4 ~ _ _ c5 ~ ~ ~ _ _ _ ,
        _ f4 ~ ~ _ _ e4 ~ ~ _ _ d4 ~ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        c6 ~ ~ ~ _ _ b5 ~ ~ _ _ d#6 ~ ~ ~ a5 ,
        _ _ b5 ~ ~ _ _ f#6 ~ _ _ a#5 ~ ~ _ d5 ,
        e6 ~ ~ _ _ d6 ~ _ _ a5 ~ ~ ~ _ d6 a5 ,
        _ d6 ~ ~ _ _ a5 ~ ~ _ _ f#5 ~ _ c5 b4 ,
        e6 ~ ~ ~ _ _ d6 ~ ~ _ _ g#5 ~ ~ ~ c6 ,
        _ _ d6 ~ ~ _ _ f#5 ~ _ _ c#6 ~ ~ _ b5 ,
        g6 ~ ~ _ _ f6 ~ _ _ e6 ~ ~ ~ _ b5 e6 ,
        _ f6 ~ ~ _ _ e6 ~ ~ _ _ d#6 ~ _ g6 g6 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: glass_pluck
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ g6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ f6 ~ _ _ _ _ _ a6 ~ _ _ c6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ e6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ f6 ~ _ _ a6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ g6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ a6 ~ _ _ _ _ _ c7 ~ _ _ e6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ a6 ~ _ _ c7 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c7 ~ _ _ e6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ g6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ a6 ~ _ _ c7 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ a6 ~ _ _ _ _ _ c7 ~ _ _ e6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b6 ~ _ _ d6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ a6 ~ _ _ c7 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c7 ~ _ _ e6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ g6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ a6 ~ _ _ c7 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Pad {
    instrument {
      SuperSynth {
        preset: choir_pad
        filter_cutoff: 3.0khz
      }
    }
    gain: -17db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.5
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: dark_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: hall
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Pad -> Master
    Atmosphere -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Pad -> Space { gain: -17db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -11.7db
    A: -10.9db
    B: -10.2db
    Hook: -9.4db
    Break: -12.1db
    Final: -9.0db
  }

  automation Counter.gain {
    Intro: -20.1db
    A: -19.3db
    B: -17.4db
    Hook: -16.6db
    Break: -20.5db
    Final: -16.2db
  }

  automation Pad.gain {
    Intro: -18.6db
    A: -17.8db
    B: -17.1db
    Hook: -16.3db
    Break: -18.2db
    Final: -15.9db
  }

  automation Atmosphere.gain {
    Intro: -21.8db
    A: -21.0db
    B: -20.3db
    Hook: -19.5db
    Break: -21.4db
    Final: -19.1db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    B: 1.04
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    B: -19db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    B: 0.8
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
      }
      Limiter {
        ceiling: -1db
      }
    }
    gain: -1db
  }
}
