import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Soft Comet Ending"
  tempo: 84bpm
  meter: 4/4
  key: C.major

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Cmaj7,
      G/B,
      Am7,
      Fmaj7,
    }
    A {
      Cmaj7,
      Em7,
      Am7,
      Fmaj7,
      Cmaj7,
      Em7,
      Am7,
      Fmaj7,
    }
    B {
      Dm7,
      Em7,
      Fmaj7,
      G7,
    }
    Hook {
      Fmaj7,
      G,
      Em7,
      Am7,
      Fmaj7,
      G,
      Em7,
      Am7,
    }
    Break {
      Dm7,
      Fmaj7,
      C,
      G,
    }
    Final {
      Fmaj7,
      G,
      Em7,
      Am7,
      Fmaj7,
      G,
      Em7,
      Am7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: soft_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        c4 ~ ~ ~ _ _ c4 ~ ~ _ _ _ _ _ _ _ ,
        _ _ f4 ~ ~ _ _ d4 ~ _ _ a3 ~ ~ _ _ ,
        c4 ~ ~ _ _ c4 ~ _ _ g4 ~ ~ ~ _ _ _ ,
        _ c4 ~ ~ _ _ g4 ~ ~ _ _ c4 ~ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        g4 ~ ~ ~ _ _ e4 ~ ~ _ _ c4 ~ ~ ~ _ ,
        _ _ e4 ~ ~ _ _ d4 ~ _ _ c4 ~ ~ _ e4 ,
        e4 ~ ~ _ _ c4 ~ _ _ e4 ~ ~ ~ _ g4 ~ ,
        _ c4 ~ ~ _ _ e4 ~ ~ _ _ f4 ~ _ c4 ~ ,
        e4 ~ ~ ~ _ _ f4 ~ ~ _ _ c4 ~ ~ ~ _ ,
        _ _ f4 ~ ~ _ _ d4 ~ _ _ c4 ~ ~ _ g4 ,
        e4 ~ ~ _ _ c4 ~ _ _ g4 ~ ~ ~ _ e4 ~ ,
        _ c4 ~ ~ _ _ g4 ~ ~ _ _ e4 ~ _ c4 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        c5 ~ ~ ~ _ _ e5 ~ ~ _ _ f5 ~ ~ ~ _ ,
        _ _ e4 ~ ~ _ _ f#4 ~ _ _ d#4 ~ ~ _ g4 ,
        f4 ~ ~ _ _ c4 ~ _ _ e4 ~ ~ ~ _ c4 ~ ,
        _ c5 ~ ~ _ _ e5 ~ ~ _ _ f#5 ~ _ f5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        c6 ~ ~ ~ _ _ f5 ~ ~ _ _ a4 ~ ~ ~ _ ,
        _ _ f5 ~ ~ _ _ a#4 ~ _ _ a#4 ~ ~ _ g5 ,
        b5 ~ ~ _ _ c6 ~ _ _ g5 ~ ~ ~ _ d5 ~ ,
        _ c6 ~ ~ _ _ g5 ~ ~ _ _ b4 ~ _ a4 ~ ,
        e5 ~ ~ ~ _ _ e5 ~ ~ _ _ a4 ~ ~ ~ _ ,
        _ _ e5 ~ ~ _ _ a#4 ~ _ _ a#4 ~ ~ _ d5 ,
        b5 ~ ~ _ _ c6 ~ _ _ e5 ~ ~ ~ _ e5 ~ ,
        _ c6 ~ ~ _ _ e5 ~ ~ _ _ b4 ~ _ a4 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        d4 ~ ~ ~ _ _ d4 ~ ~ _ _ _ _ _ _ _ ,
        _ _ f4 ~ ~ _ _ d4 ~ _ _ a3 ~ ~ _ _ ,
        c4 ~ ~ _ _ c4 ~ _ _ g4 ~ ~ ~ _ _ _ ,
        _ c4 ~ ~ _ _ g4 ~ ~ _ _ b4 ~ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        f5 ~ ~ ~ _ _ e5 ~ ~ _ _ b4 ~ ~ ~ a4 ,
        _ _ e6 ~ ~ _ _ c#6 ~ _ _ a#5 ~ ~ _ d5 ,
        d6 ~ ~ _ _ c6 ~ _ _ e5 ~ ~ ~ _ f5 d5 ,
        _ c6 ~ ~ _ _ e5 ~ ~ _ _ d#5 ~ _ d5 a4 ,
        c6 ~ ~ ~ _ _ f5 ~ ~ _ _ b4 ~ ~ ~ a4 ,
        _ _ f5 ~ ~ _ _ c#5 ~ _ _ a#4 ~ ~ _ g5 ,
        d6 ~ ~ _ _ c6 ~ _ _ g5 ~ ~ ~ _ e5 d5 ,
        _ c6 ~ ~ _ _ g5 ~ ~ _ _ b4 ~ _ d5 a4 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: mallet
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ g5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f6 ~ _ _ _ _ _ _ a5 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ f6 ~ _ _ _ _ _ a5 ~ _ _ c6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ e6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ f6 ~ _ _ a5 ~ ,
        _ _ _ g5 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ g6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ g6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ a5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument: bass
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
  
    effects {
      ChannelStrip {
        preset: bass
      }
    }
}

  track Piano {
    instrument: piano
    gain: -13db
    pan: -0.10
    Harmony |> PianoVoicing(range: c3..c5, voice_leading: nearest, voices: 4)
  
    effects {
      ChannelStrip {
        preset: keys
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: string_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_pop
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    A {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xxx...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    B {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    Hook {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }
    Break {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    Final {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2066
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_pop
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    A {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xxx...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    B {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "..............................x...............................x."
      Tom "............................................................x.xx"
    }
    Hook {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }
    Break {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
      Tom "............................................................x.xx"
    }
    Final {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }

    humanize {
      timing: 3ms
      velocity: 0.04
      seed: 1066
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  bus Delay {
    StereoDelay {
      time: 1/8d
      feedback: 0.24
      mix: 1.0
      mode: ping_pong
    }
    gain: -4db
  }
  bus Space {
    Reverb {
      preset: plate
      mix: 1.0
    }
    gain: -5db
  }


  routing {
    Lead -> Master
    Counter -> Master
    Bass -> Master
    Piano -> Master
    Atmosphere -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
    Lead -> Space { gain: -19db mode: post_fader }
    Counter -> Space { gain: -17db mode: post_fader }
    Piano -> Space { gain: -19db mode: post_fader }
    Atmosphere -> Space { gain: -17db mode: post_fader }
    Drums -> Space { gain: -24db mode: post_fader }
    Space -> Master
  }
  // PRO_ARRANGEMENT_AUTOMATION_BEGIN
  automation Lead.gain {
    Intro: -11.9db
    A: -11.1db
    B: -10.4db
    Hook: -9.6db
    Break: -12.3db
    Final: -9.2db
  }

  automation Counter.gain {
    Intro: -19.8db
    A: -19.0db
    B: -17.1db
    Hook: -16.3db
    Break: -20.2db
    Final: -15.9db
  }

  automation Bass.gain {
    Intro: -11.8db
    A: -11.0db
    B: -10.3db
    Hook: -9.5db
    Break: -12.8db
    Final: -9.1db
  }

  automation Piano.gain {
    Intro: -15.0db
    A: -14.2db
    B: -13.5db
    Hook: -12.7db
    Break: -15.4db
    Final: -12.3db
  }

  automation Atmosphere.gain {
    Intro: -21.7db
    A: -20.9db
    B: -20.2db
    Hook: -19.4db
    Break: -21.3db
    Final: -19.0db
  }
  // PRO_ARRANGEMENT_AUTOMATION_END




  // PRIORITY_A_AUTOMATION_BEGIN

  automation Lead.instrument.filter_cutoff {
    Intro: 4200hz
    A: 5600hz
    B: 7000hz
    Hook: 9000hz
    Break: 3800hz
    Final: 10200hz
  }

  automation Lead.stereo.width {
    Intro: 0.82
    A: 0.96
    B: 1.04
    Hook: 1.22
    Break: 0.78
    Final: 1.30
  }

  automation Lead.send.Space {
    Intro: -23db
    A: -21db
    B: -19db
    Hook: -17db
    Break: -24db
    Final: -16db
  }

  automation Lead.effects.ChannelStrip.mid_gain {
    Intro: 0.0
    A: 0.4
    B: 0.8
    Hook: 1.2
    Break: -0.6
    Final: 1.5
  }

  // PRIORITY_A_AUTOMATION_END

  master {
    effects {
      Compressor {
        threshold: -14db
        ratio: 2
        attack: 10ms
        release: 120ms
      }
      Limiter {
        ceiling: -1db
      }
    }
    gain: -1db
  }
}
