import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Starforge Opening"
  tempo: 184bpm
  meter: 4/4
  key: E.minor

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Em,
      Cmaj7,
      G,
      D,
    }
    A {
      Em,
      Cmaj7,
      G,
      D,
      Em,
      Cmaj7,
      G,
      D,
    }
    B {
      Am7,
      Bm7,
      Cmaj7,
      D,
    }
    Hook {
      Cmaj7,
      D,
      Em,
      Bm7,
      Cmaj7,
      D,
      Em,
      Bm7,
    }
    Break {
      Am7,
      Cmaj7,
      Em,
      D,
    }
    Final {
      Cmaj7,
      D,
      Em,
      Bm7,
      Cmaj7,
      D,
      Em,
      Bm7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: octave_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        b3 ~ b3 ~ _ a3 ~ _ b3 ~ ~ _ e4 ~ _ _ ,
        g4 ~ ~ _ g4 ~ _ c5 ~ _ e5 ~ _ _ _ _ ,
        _ a4 ~ _ b4 ~ _ _ g4 ~ d5 ~ _ b4 ~ _ ,
        a4 ~ _ g4 ~ _ d5 ~ _ a4 ~ ~ _ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        g4 ~ d5 ~ _ c5 ~ _ g4 ~ ~ _ e4 ~ _ b4 ,
        e5 ~ ~ _ c5 ~ _ a4 ~ _ e4 ~ _ c4 ~ ~ ,
        _ c5 ~ _ b4 ~ _ _ g4 ~ b4 ~ _ a4 ~ d5 ,
        a4 ~ _ e4 ~ _ b4 ~ _ a4 ~ ~ _ d5 ~ ~ ,
        e4 ~ b4 ~ _ a4 ~ _ b4 ~ ~ _ g4 ~ _ e4 ,
        c5 ~ ~ _ b4 ~ _ c5 ~ _ g4 ~ _ e4 ~ ~ ,
        _ a4 ~ _ d5 ~ _ _ g4 ~ d5 ~ _ c5 ~ b4 ,
        d5 ~ _ g4 ~ _ d5 ~ _ c5 ~ ~ _ a4 ~ ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        c5 ~ d5 ~ _ c5 ~ _ c5 ~ ~ _ g4 ~ _ e4 ,
        a5 ~ ~ _ f#5 ~ _ c#5 ~ _ e5 ~ _ d5 ~ ~ ,
        _ c5 ~ _ e5 ~ _ _ g5 ~ b5 ~ _ a5 ~ g5 ,
        d5 ~ _ f5 ~ _ b4 ~ _ a4 ~ ~ _ d5 ~ ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        c6 ~ b5 ~ _ a5 ~ _ b5 ~ ~ _ e5 ~ _ c6 ,
        a5 ~ ~ _ f#5 ~ _ c#6 ~ _ g5 ~ _ d6 ~ ~ ,
        _ a5 ~ _ b5 ~ _ _ g5 ~ d6 ~ _ c6 ~ g5 ,
        a5 ~ _ c#5 ~ _ d5 ~ _ c6 ~ ~ _ f#5 ~ ~ ,
        e6 ~ d6 ~ _ c6 ~ _ g5 ~ ~ _ c5 ~ _ g5 ,
        d6 ~ ~ _ a5 ~ _ g#5 ~ _ e5 ~ _ a5 ~ ~ ,
        _ c6 ~ _ g5 ~ _ _ e5 ~ b5 ~ _ a5 ~ b5 ,
        f#5 ~ _ a#4 ~ _ b4 ~ _ a5 ~ ~ _ a5 ~ ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        c4 ~ b3 ~ _ a3 ~ _ c4 ~ ~ _ _ _ _ _ ,
        b4 ~ ~ _ g4 ~ _ c5 ~ _ _ _ _ _ _ _ ,
        _ a4 ~ _ b4 ~ _ _ g4 ~ e4 ~ _ _ _ _ ,
        a4 ~ _ g4 ~ _ d5 ~ _ _ _ _ _ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        g6 ~ d6 ~ _ c6 ~ _ g5 ~ ~ _ c5 ~ _ b4 ,
        d6 ~ ~ _ d6 ~ _ g#5 ~ _ e5 ~ _ b5 ~ a5 ,
        _ c6 ~ _ b5 ~ _ _ e5 ~ b5 ~ _ a5 ~ e6 ,
        f#6 ~ _ c#6 ~ _ b5 ~ _ a5 ~ ~ _ c6 ~ f#5 ,
        c6 ~ b5 ~ _ a5 ~ _ c6 ~ ~ _ g5 ~ _ c6 ,
        a5 ~ ~ _ a5 ~ _ c#6 ~ _ g5 ~ _ d6 ~ d6 ,
        _ g6 ~ _ e6 ~ _ _ g5 ~ d6 ~ _ c6 ~ b5 ,
        b5 ~ _ f5 ~ _ d6 ~ _ c6 ~ ~ _ a5 ~ d5 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: pop_brass
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ a6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a6 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ c6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ b5 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b6 ~ _ _ e6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ a6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a6 ~ ,
        _ _ _ g6 ~ _ _ _ _ _ b6 ~ _ _ e6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g6 ~ _ _ b6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ d6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ e6 ~ _ _ g6 ~ ,
        _ _ _ b6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: synth_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Guitar {
    instrument: guitar
    gain: -12db
    pan: -0.16
    Harmony |> GuitarVoicing(style: open, voice_leading: nearest) |> GuitarStrum(style: driving)
  
    effects {
      ChannelStrip {
        preset: guitar
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: synth_strings
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_rock
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    A {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xxx...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    B {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
    }
    Hook {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }
    Break {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
    }
    Final {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2059
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_rock
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...x."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    A {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xxx...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
      Snare "....X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    B {
      @16:
      Kick "x...x..x..x...x.x...x..x..x...x.x...x..x..x...x.x...x..x..x...xx"
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "..............................x...............................x."
      Tom "............................................................x.xx"
    }
    Hook {
      @16:
      Kick "x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xxx.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...x.x.x...xx"
      Snare "....X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
