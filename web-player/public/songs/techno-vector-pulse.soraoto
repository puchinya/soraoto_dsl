    Lead -> Master
    Counter -> Master
    Bass -> Master
    Pad -> Master
    Kick -> Master
    Drums -> Master
    Lead -> Delay { gain: -16db mode: post_fader }
    Counter -> Delay { gain: -19db mode: post_fader }
    Delay -> Master
  
