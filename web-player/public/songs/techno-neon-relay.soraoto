  track Bass {
    instrument {
      SuperSynth {
        preset: reese_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Arp {
    instrument {
      SuperSynth {
        preset: pulse_motion
        filter_cutoff: 6.0khz
      }
    }
    gain: -17db
    Harmony |> Arpeggio(pattern: [1, 5, 3, 7], duration: @16, range: c4..c7)
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: airy_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

