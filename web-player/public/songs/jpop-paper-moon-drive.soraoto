import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Paper Moon Drive"
  tempo: 126bpm
  meter: 4/4
  key: A.major

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Amaj7,
      E/G#,
      F#m7,
      Dmaj7,
    }
    A {
      Amaj7,
      C#m7,
      F#m7,
      Dmaj7,
      Amaj7,
      C#m7,
      F#m7,
      Dmaj7,
    }
    B {
      Bm7,
      C#m7,
      Dmaj7,
      E7,
    }
    Hook {
      Dmaj7,
      E,
      C#m7,
      F#m7,
      Dmaj7,
      E,
      C#m7,
      F#m7,
    }
    Break {
      Bm7,
      E7,
      Amaj7,
      F#m7,
    }
    Final {
      Dmaj7,
      E,
      C#m7,
      F#m7,
      Dmaj7,
      E,
      C#m7,
      F#m7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: vintage_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        c#4 ~ ~ ~ _ _ b3 ~ _ _ a3 ~ _ _ _ _ ,
        b3 ~ _ _ b3 ~ ~ ~ _ _ a3 ~ ~ _ _ _ ,
        _ _ a4 ~ _ e4 ~ ~ _ f#4 ~ _ _ _ _ _ ,
        f#4 ~ ~ _ d4 ~ _ _ c#4 ~ ~ _ _ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        g#4 ~ ~ ~ _ _ c#4 ~ _ _ f#4 ~ _ a4 ~ ~ ,
        e4 ~ _ _ c#4 ~ ~ ~ _ _ e4 ~ ~ _ _ e4 ,
        _ _ f#4 ~ _ e4 ~ ~ _ c#4 ~ _ f#4 ~ ~ _ ,
        a4 ~ ~ _ d4 ~ _ _ d4 ~ ~ _ _ c#4 ~ ~ ,
        e4 ~ ~ ~ _ _ b3 ~ _ _ a3 ~ _ a3 ~ ~ ,
        e4 ~ _ _ c#4 ~ ~ ~ _ _ e4 ~ ~ _ _ g#4 ,
        _ _ a4 ~ _ e5 ~ ~ _ d5 ~ _ f#5 ~ ~ _ ,
        a4 ~ ~ _ f#4 ~ _ _ d4 ~ ~ _ _ a4 ~ ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        b4 ~ ~ ~ _ _ c#5 ~ _ _ f#5 ~ _ d5 ~ ~ ,
        b4 ~ _ _ e5 ~ ~ ~ _ _ e5 ~ ~ _ _ b4 ,
        _ _ f#5 ~ _ e5 ~ ~ _ c#5 ~ _ a4 ~ ~ _ ,
        b4 ~ ~ _ g#4 ~ _ _ e4 ~ ~ _ _ e4 ~ ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        d6 ~ ~ ~ _ _ b5 ~ _ _ a5 ~ _ f#5 ~ ~ ,
        b5 ~ _ _ b5 ~ ~ ~ _ _ e5 ~ ~ _ _ e5 ,
        _ _ a5 ~ _ e5 ~ ~ _ d5 ~ _ e5 ~ ~ _ ,
        f#5 ~ ~ _ e5 ~ _ _ c#5 ~ ~ _ _ f#5 ~ ~ ,
        d6 ~ ~ ~ _ _ c#6 ~ _ _ f#5 ~ _ f#5 ~ ~ ,
        e6 ~ _ _ g#5 ~ ~ ~ _ _ e5 ~ ~ _ _ e5 ,
        _ _ f#5 ~ _ e5 ~ ~ _ c#5 ~ _ c#5 ~ ~ _ ,
        f#5 ~ ~ _ c#5 ~ _ _ a4 ~ ~ _ _ a4 ~ ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        d4 ~ ~ ~ _ _ b3 ~ _ _ b3 ~ _ _ _ _ ,
        d4 ~ _ _ b3 ~ ~ ~ _ _ a3 ~ ~ _ _ _ ,
        _ _ a4 ~ _ e4 ~ ~ _ g#4 ~ _ _ _ _ _ ,
        f#4 ~ ~ _ e4 ~ _ _ c#4 ~ ~ _ _ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        f#5 ~ ~ ~ _ _ c#5 ~ _ _ f#5 ~ _ e5 ~ d5 ,
        e6 ~ _ _ b5 ~ ~ ~ _ _ e5 ~ ~ _ _ e5 ,
        _ _ f#6 ~ _ e6 ~ ~ _ c#6 ~ _ e5 ~ ~ c#5 ,
        f#5 ~ ~ _ e5 ~ _ _ c#5 ~ ~ _ _ a4 ~ f#5 ,
        d6 ~ ~ ~ _ _ b5 ~ _ _ a5 ~ _ e5 ~ f#5 ,
        e6 ~ _ _ b5 ~ ~ ~ _ _ e5 ~ ~ _ _ g#5 ,
        _ _ a5 ~ _ e5 ~ ~ _ d5 ~ _ e5 ~ ~ c#6 ,
        f#5 ~ ~ _ f#5 ~ _ _ e5 ~ ~ _ _ f#5 ~ f#5 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: ep_keys
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g#5 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g#5 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ d6 ~ _ _ _ _ _ f#6 ~ _ _ a5 ~ ,
        _ _ _ g#5 ~ _ _ _ _ _ b5 ~ _ _ c#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#5 ~ _ _ b5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ g#6 ~ _ _ _ _ _ b5 ~ _ _ e6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ b5 ~ _ _ _ _ _ _ d6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ f#6 ~ _ _ _ _ _ _ a5 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ e6 ~ _ _ _ _ _ g#6 ~ _ _ b5 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ g#6 ~ _ _ _ _ _ b5 ~ _ _ e6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: pluck_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Piano {
    instrument: piano
    gain: -13db
    pan: -0.10
    Harmony |> PianoVoicing(range: c3..c5, voice_leading: nearest, voices: 4)
  
    effects {
      ChannelStrip {
        preset: keys
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: analog_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_pop
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2045
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_pop
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "..............................x...............................x."
      Tom "............................................................x.xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
      Tom "............................................................x.xx"
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
      Snare "....X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
