import component Sidechain from "std:components/sidechain"
import component StereoDelay from "std:components/stereo-delay"
import plugin SuperSynth from "../wasm/plugins/dsp/super-synth/plugin.wasm"

project {
  version: 1
  title: "Blue Hour Signal"
  tempo: 148bpm
  meter: 4/4
  key: D.major

  structure {
    Intro { bars: 4 }
    A { bars: 8 }
    B { bars: 4 }
    Hook { bars: 8 }
    Break { bars: 4 }
    Final { bars: 8 }
  }

  chords Harmony {
    Intro {
      Dmaj7,
      A/C#,
      Bm7,
      Gmaj7,
    }
    A {
      D,
      A/C#,
      Bm7,
      Gmaj7,
      D,
      A/C#,
      Bm7,
      Gmaj7,
    }
    B {
      Em7,
      F#m7,
      Gmaj7,
      A,
    }
    Hook {
      Gmaj7,
      A,
      Bm7,
      F#m7,
      Gmaj7,
      A,
      Bm7,
      F#m7,
    }
    Break {
      Em7,
      Gmaj7,
      D,
      A,
    }
    Final {
      Gmaj7,
      A,
      Bm7,
      F#m7,
      Gmaj7,
      A,
      Bm7,
      F#m7,
    }
  }

  track Lead {
    instrument {
      SuperSynth {
        preset: octave_lead
      }
    }
    gain: -10db
    Intro {
      notes {
        @16:
        !mp:
        a3 ~ ~ _ d4 ~ _ f#4 ~ ~ _ _ _ _ _ _ ,
        _ f#4 ~ _ a4 ~ ~ _ e4 ~ _ c#4 ~ _ _ _ ,
        a4 ~ _ g4 ~ _ e4 ~ ~ ~ _ _ a4 ~ _ _ ,
        d4 ~ ~ ~ _ _ e4 ~ _ f#4 ~ ~ _ _ _ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        d4 ~ ~ _ a4 ~ _ b4 ~ ~ _ _ f#4 ~ ~ _ ,
        _ a4 ~ _ c#5 ~ ~ _ e5 ~ _ d5 ~ _ e5 ~ ,
        d5 ~ _ f#5 ~ _ d5 ~ ~ ~ _ _ f#5 ~ _ b4 ,
        d4 ~ ~ ~ _ _ d4 ~ _ f#4 ~ ~ _ _ g4 ~ ,
        d4 ~ ~ _ f#4 ~ _ a4 ~ ~ _ _ f#4 ~ ~ _ ,
        _ f#4 ~ _ a4 ~ ~ _ a4 ~ _ e4 ~ _ a4 ~ ,
        b4 ~ _ g4 ~ _ e4 ~ ~ ~ _ _ b4 ~ _ d5 ,
        f#4 ~ ~ ~ _ _ e4 ~ _ a4 ~ ~ _ _ b4 ~ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        g4 ~ ~ _ d5 ~ _ d#5 ~ ~ _ _ g5 ~ ~ _ ,
        _ a4 ~ _ e5 ~ ~ _ a4 ~ _ f4 ~ _ a4 ~ ,
        f#5 ~ _ a#5 ~ _ d6 ~ ~ ~ _ _ b5 ~ _ d6 ,
        a4 ~ ~ ~ _ _ d4 ~ _ f#4 ~ ~ _ _ c#5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        b5 ~ ~ _ d5 ~ _ f#5 ~ ~ _ _ d5 ~ ~ _ ,
        _ f#5 ~ _ a5 ~ ~ _ e5 ~ _ c5 ~ _ a5 ~ ,
        a5 ~ _ f5 ~ _ e5 ~ ~ ~ _ _ a5 ~ _ b5 ,
        e5 ~ ~ ~ _ _ e5 ~ _ a5 ~ ~ _ _ f#5 ~ ,
        b5 ~ ~ _ f#5 ~ _ f#5 ~ ~ _ _ d5 ~ ~ _ ,
        _ a5 ~ _ a5 ~ ~ _ e5 ~ _ c5 ~ _ e5 ~ ,
        b5 ~ _ f5 ~ _ d5 ~ ~ ~ _ _ d5 ~ _ a5 ,
        c#6 ~ ~ ~ _ _ d6 ~ _ f#5 ~ ~ _ _ f#5 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        b3 ~ ~ _ e4 ~ _ g4 ~ ~ _ _ _ _ _ _ ,
        _ f#4 ~ _ g4 ~ ~ _ f#4 ~ _ _ _ _ _ _ ,
        a4 ~ _ g4 ~ _ d4 ~ ~ ~ _ _ _ _ _ _ ,
        e4 ~ ~ ~ _ _ e4 ~ _ e4 ~ ~ _ _ _ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        d6 ~ ~ _ g5 ~ _ a#5 ~ ~ _ _ d5 ~ ~ b4 ,
        _ a5 ~ _ a5 ~ ~ _ e5 ~ _ c5 ~ _ f#5 a5 ,
        b5 ~ _ f5 ~ _ d5 ~ ~ ~ _ _ f#5 ~ _ b5 ,
        e6 ~ ~ ~ _ _ d6 ~ _ f#5 ~ ~ _ _ a5 f#5 ,
        b5 ~ ~ _ d5 ~ _ f#5 ~ ~ _ _ f#5 ~ ~ d5 ,
        _ f#6 ~ _ a5 ~ ~ _ a5 ~ _ d#5 ~ _ a5 a5 ,
        b5 ~ _ g#5 ~ _ e5 ~ ~ ~ _ _ b5 ~ _ b5 ,
        f#5 ~ ~ ~ _ _ e5 ~ _ a5 ~ ~ _ _ b5 e5 ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Counter {
    instrument {
      SuperSynth {
        preset: bright_pluck
      }
    }
    gain: -17db
    pan: 0.22
    Intro {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ e6 ~ _ _ _ _ _ _ a5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
      }
    }
    A {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ a5 ~ _ _ _ _ _ _ c#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c#6 ~ _ _ _ _ _ _ e6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ g6 ~ _ _ _ _ _ _ b5 ~ _ ,
      }
    }
    B {
      notes {
        @16:
        !mf:
        _ _ _ g6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ f#6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ g6 ~ _ _ b5 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ a5 ~ ,
      }
    }
    Hook {
      notes {
        @16:
        !f:
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ a6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
      }
    }
    Break {
      notes {
        @16:
        !mp:
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ d6 ~ _ _ _ _ _ _ f#6 ~ _ ,
        _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ,
        _ _ _ _ _ c#6 ~ _ _ _ _ _ _ e6 ~ _ ,
      }
    }
    Final {
      notes {
        @16:
        !ff:
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ c#6 ~ _ _ e6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
        _ _ _ b5 ~ _ _ _ _ _ d6 ~ _ _ f#6 ~ ,
        _ _ _ c#6 ~ _ _ _ _ _ e6 ~ _ _ a6 ~ ,
        _ _ _ a6 ~ _ _ _ _ _ b5 ~ _ _ d6 ~ ,
        _ _ _ f#6 ~ _ _ _ _ _ a6 ~ _ _ c#6 ~ ,
      }
    }
  
    effects {
      ChannelStrip {
        preset: lead
      }
    }
}

  track Bass {
    instrument {
      SuperSynth {
        preset: round_bass
      }
    }
    gain: -10db
    Harmony |> BassRoot(octave: 2, mode: chord_bass)
    effects {
      ChannelStrip {
        preset: bass
      }
      Sidechain {
        source: Kick
        amount: -4db
        attack: 5ms
        release: 110ms
      }
    }
  }

  track Guitar {
    instrument: guitar
    gain: -12db
    pan: -0.16
    Harmony |> GuitarVoicing(style: open, voice_leading: nearest) |> GuitarStrum(style: driving)
  
    effects {
      ChannelStrip {
        preset: guitar
      }
    }
}

  track Atmosphere {
    instrument {
      SuperSynth {
        preset: dream_pad
        filter_cutoff: 2.8khz
      }
    }
    gain: -20db
    Harmony |> PadVoicing(range: c4..c6, voice_leading: smooth, voices: 4)
    stereo {
      width: 1.7
      balance: 0
    }
  
    effects {
      ChannelStrip {
        preset: pad
      }
    }
}

  track Kick {

    instrument: drums_pop
    gain: -8db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
    }

    humanize {
      timing: 1ms
      velocity: 0.018
      seed: 2031
    }
  }
  
    effects {
      ChannelStrip {
        preset: drums
      }
    }
}

  track Drums {

    instrument: drums_pop
    gain: -11db
    drums {
    Intro {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    A {
      @16:
      Kick "x.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.xx.....x.x....x..x.....x.x....x..x.....x.x....x..x.....x.x....x.x"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
    }
    B {
      @16:
      Kick "x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..x.x..x..xx"
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "..............................x...............................x."
      Tom "............................................................x.xx"
    }
    Hook {
      @16:
      Kick "x..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxxx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..x.xx..x..x.x.x..xxx"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
      Crash "X..............................................................................................................................."
    }
    Break {
      @16:
      Kick "x.......x.......x.......x.......x.......x.......x.......x......."
      Snare "....X.......X.......X.......X.......X.......X.......X.......X..."
      Hat "x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x."
      Tom "............................................................x.xx"
    }
    Final {
      @16:
      Kick "x..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xxx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x..xx..x..x.x.x.x.xx"
      Snare "....X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X.......X.....g.X.......X.......X.......X.......X..."
      Hat "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      OpenHat "......................x.......x.......................x.......x.......................x.......x.......................x.......x."
      Tom "............................................................x.xx............................................................x.xx"
